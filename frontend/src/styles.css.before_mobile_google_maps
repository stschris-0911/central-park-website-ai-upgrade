:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #0f172a;
  background: #e5e7eb;
}

* { box-sizing: border-box; }
html, body, #root { margin: 0; min-height: 100%; height: 100%; }
body { background: #e5e7eb; }
button, input { font: inherit; }

.app-shell {
  height: 100vh;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 380px;
  overflow: hidden;
}

.map-shell {
  position: relative;
  background: #cbd5e1;
}

.map-root {
  height: 100%;
  width: 100%;
  z-index: 1;
}

.topbar {
  position: absolute;
  top: 16px;
  left: 16px;
  right: 16px;
  z-index: 1000;
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 12px 14px;
  border-radius: 18px;
  background: rgba(255,255,255,0.96);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);
}

.topbar__title {
  font-weight: 700;
  white-space: nowrap;
}

.topbar__search {
  flex: 1;
  min-width: 0;
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  padding: 10px 12px;
  background: #fff;
}

.legend-card,
.route-card {
  position: absolute;
  z-index: 1000;
  background: rgba(255,255,255,0.96);
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);
  border-radius: 18px;
  padding: 14px;
  max-width: 360px;
}

.legend-card {
  right: 16px;
  bottom: 16px;
  width: 320px;
}

.route-card {
  left: 16px;
  bottom: 16px;
  width: 360px;
  max-height: 48vh;
  overflow: auto;
}

.legend-card h3,
.route-card h3,
.route-card h4,
.chat-panel h2 {
  margin: 0 0 10px;
}

.legend-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px 12px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
}

.legend-swatch {
  width: 12px;
  height: 12px;
  border-radius: 999px;
  display: inline-block;
}

.legend-note {
  margin: 12px 0 0;
  color: #475569;
  font-size: 13px;
}

.route-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}

.route-card__header button,
.chat-panel__footer button,
.chat-quick-actions button {
  border: 0;
  border-radius: 12px;
  background: #0f172a;
  color: white;
  padding: 8px 12px;
  cursor: pointer;
}

.route-meta {
  display: grid;
  gap: 8px;
  font-size: 14px;
  margin-bottom: 10px;
}

.route-description {
  margin: 0 0 12px;
  color: #334155;
  font-size: 14px;
  line-height: 1.4;
}

.path-node-list {
  display: grid;
  gap: 10px;
}

.path-node-item {
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 10px;
  background: #f8fafc;
}

.path-node-item__title {
  font-weight: 700;
  margin-bottom: 4px;
}

.path-node-item__meta {
  color: #475569;
  font-size: 13px;
  margin-bottom: 4px;
}

.path-node-item__desc {
  font-size: 13px;
  line-height: 1.4;
}

.chat-panel {
  height: 100vh;
  display: grid;
  grid-template-rows: auto 1fr auto;
  background: white;
  border-left: 1px solid #e2e8f0;
}

.chat-panel__header,
.chat-panel__footer {
  padding: 16px;
  border-bottom: 1px solid #e2e8f0;
}

.chat-panel__footer {
  border-bottom: 0;
  border-top: 1px solid #e2e8f0;
  display: grid;
  gap: 12px;
}

.chat-panel__header p {
  margin: 0;
  color: #475569;
  font-size: 14px;
  line-height: 1.4;
}

.chat-panel__messages {
  overflow: auto;
  padding: 16px;
  display: grid;
  gap: 12px;
  align-content: start;
  background: #f8fafc;
}

.chat-bubble {
  max-width: 90%;
  padding: 12px 14px;
  border-radius: 16px;
  line-height: 1.45;
  font-size: 14px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
}

.chat-bubble--assistant {
  background: white;
  color: #0f172a;
  justify-self: start;
}

.chat-bubble--user {
  background: #0f172a;
  color: white;
  justify-self: end;
}

.chat-quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chat-quick-actions button {
  background: #e2e8f0;
  color: #0f172a;
}

.chat-input-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
}

.chat-input-row input {
  border: 1px solid #cbd5e1;
  border-radius: 12px;
  padding: 10px 12px;
}

@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: 1fr;
    grid-template-rows: 60vh 40vh;
  }

  .chat-panel {
    height: auto;
  }

  .legend-card {
    width: 280px;
  }

  .route-card {
    width: 300px;
  }
}

/* ================================
   iOS / Mobile App Layout
   ================================ */

@media (max-width: 768px) {
  html,
  body,
  #root {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }

  body {
    background: #f8fafc;
  }

  .app-shell {
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    position: relative;
  }

  /* Top search/header card */
  .top-bar {
    position: fixed;
    top: calc(env(safe-area-inset-top) + 8px);
    left: 12px;
    right: 12px;
    z-index: 1200;

    display: flex;
    align-items: center;
    gap: 8px;

    padding: 10px 12px;
    border-radius: 18px;

    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
    backdrop-filter: blur(12px);
  }

  .top-bar h1,
  .top-bar__title {
    font-size: 15px;
    line-height: 1.1;
    max-width: 42vw;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .top-bar input,
  .top-bar .search-input,
  input[type="search"] {
    min-width: 0;
    flex: 1;
    height: 36px;
    font-size: 15px;
    border-radius: 12px;
  }

  /* Map should become the main canvas */
  .map-card,
  .map-panel,
  .map-wrapper {
    position: fixed;
    inset: 0;
    z-index: 1;
    border-radius: 0;
    overflow: hidden;
  }

  .leaflet-container {
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
  }

  /* Hide legend on iPhone first version */
  .legend-card {
    display: none !important;
  }

  /* Route panel as compact floating card */
  .route-card {
    position: fixed;
    left: 12px;
    right: 12px;
    top: calc(env(safe-area-inset-top) + 82px);
    z-index: 1100;

    max-height: 25vh;
    overflow-y: auto;

    border-radius: 18px;
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
    backdrop-filter: blur(12px);
  }

  .route-card__header h3 {
    font-size: 15px;
  }

  .route-card__header button {
    padding: 6px 10px;
    border-radius: 10px;
    font-size: 13px;
  }

  .route-meta {
    font-size: 13px;
    line-height: 1.35;
  }

  .route-description {
    font-size: 13px;
    line-height: 1.35;
  }

  .path-node-list {
    margin-top: 8px;
  }

  .path-node-list h4 {
    font-size: 13px;
    margin: 8px 0;
  }

  .path-node-item {
    padding: 8px 0;
  }

  .path-node-item__title {
    font-size: 13px;
  }

  .path-node-item__meta,
  .path-node-item__desc {
    font-size: 12px;
    line-height: 1.3;
  }

  /* Chat as bottom sheet */
  .chat-panel {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1150;

    height: 36vh;
    height: 36dvh;

    border-radius: 24px 24px 0 0;
    padding: 14px;
    padding-bottom: calc(14px + env(safe-area-inset-bottom));

    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 -10px 30px rgba(15, 23, 42, 0.2);
    backdrop-filter: blur(14px);

    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chat-panel h3 {
    font-size: 15px;
    margin: 0 0 8px 0;
  }

  .chat-messages,
  .chat-panel__messages,
  .message-list {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    padding-right: 2px;
  }

  .chat-message,
  .message {
    font-size: 13px;
    line-height: 1.35;
  }

  .quick-actions,
  .suggestion-row,
  .chat-suggestions {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 6px 0 8px 0;
    -webkit-overflow-scrolling: touch;
  }

  .quick-actions button,
  .suggestion-row button,
  .chat-suggestions button {
    flex: 0 0 auto;
    white-space: nowrap;
    font-size: 13px;
    padding: 8px 10px;
    border-radius: 999px;
  }

  .chat-input-row,
  .chat-form {
    display: flex;
    gap: 8px;
    align-items: center;
    padding-top: 8px;
  }

  .chat-input-row input,
  .chat-form input {
    min-width: 0;
    flex: 1;
    height: 44px;
    font-size: 16px;
    border-radius: 14px;
  }

  .chat-input-row button,
  .chat-form button {
    height: 44px;
    padding: 0 16px;
    border-radius: 14px;
    font-size: 15px;
    white-space: nowrap;
  }

  /* Reduce map zoom control overlap */
  .leaflet-control-zoom {
    margin-top: calc(env(safe-area-inset-top) + 90px) !important;
    margin-left: 12px !important;
  }

  .leaflet-control-attribution {
    display: none;
  }
}


/* =========================================================
   Google Maps-like iOS layout
   ========================================================= */

@media (max-width: 768px) {
  html,
  body,
  #root {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
    background: #eef2f7;
  }

  .app-shell {
    position: relative;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #eef2f7;
  }

  /* Full-screen map */
  .map-card,
  .map-panel,
  .map-wrapper {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
    z-index: 1;
    border-radius: 0 !important;
    box-shadow: none !important;
    overflow: hidden;
  }

  .leaflet-container {
    width: 100vw !important;
    height: 100vh !important;
    height: 100dvh !important;
  }

  /* Top floating search bar like Google Maps */
  .top-bar {
    position: fixed !important;
    top: calc(env(safe-area-inset-top) + 10px);
    left: 16px;
    right: 16px;
    z-index: 1300;

    display: flex;
    align-items: center;
    gap: 10px;

    min-height: 54px;
    padding: 8px 14px;

    border-radius: 28px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 6px 22px rgba(15, 23, 42, 0.22);
    backdrop-filter: blur(16px);
  }

  .top-bar h1,
  .top-bar__title {
    display: none !important;
  }

  .top-bar::before {
    content: "📍";
    font-size: 22px;
    line-height: 1;
  }

  .top-bar input,
  .top-bar .search-input,
  input[type="search"] {
    flex: 1;
    min-width: 0;
    height: 40px;
    border: 0 !important;
    outline: none !important;
    background: transparent !important;
    font-size: 17px;
    color: #0f172a;
  }

  .top-bar input::placeholder,
  .top-bar .search-input::placeholder {
    color: #64748b;
  }

  /* Hide desktop legend on mobile */
  .legend-card {
    display: none !important;
  }

  /* Route panel: compact floating card below search */
  .route-card {
    position: fixed !important;
    left: 16px;
    right: 16px;
    top: calc(env(safe-area-inset-top) + 78px);
    z-index: 1200;

    max-height: 20vh;
    overflow-y: auto;

    padding: 12px 14px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 6px 22px rgba(15, 23, 42, 0.18);
    backdrop-filter: blur(16px);
  }

  .route-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .route-card__header h3 {
    font-size: 15px;
    margin: 0;
  }

  .route-card__header button {
    border: 0;
    border-radius: 999px;
    padding: 7px 12px;
    font-size: 13px;
    background: #0f172a;
    color: white;
  }

  .route-meta {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.35;
  }

  .route-description {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.35;
  }

  /* Hide long route lists in compact mobile mode */
  .path-node-list {
    display: none !important;
  }

  /* Bottom sheet similar to Google Maps */
  .chat-panel {
    position: fixed !important;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1250;

    height: 34vh;
    height: 34dvh;
    min-height: 250px;
    max-height: 430px;

    padding: 12px 16px;
    padding-bottom: calc(16px + env(safe-area-inset-bottom));

    border-radius: 30px 30px 0 0;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 -10px 32px rgba(15, 23, 42, 0.24);
    backdrop-filter: blur(18px);

    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .chat-panel::before {
    content: "";
    width: 44px;
    height: 5px;
    border-radius: 999px;
    background: #cbd5e1;
    margin: 0 auto 10px;
    flex: 0 0 auto;
  }

  .chat-panel h3 {
    font-size: 22px;
    margin: 0 0 6px 0;
    color: #0f172a;
  }

  .chat-panel p {
    font-size: 14px;
    line-height: 1.4;
  }

  .chat-messages,
  .chat-panel__messages,
  .message-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-right: 2px;
  }

  .chat-message,
  .message {
    font-size: 13px;
    line-height: 1.35;
  }

  /* Horizontal quick chips under search / in bottom sheet */
  .quick-actions,
  .suggestion-row,
  .chat-suggestions {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 6px 0 10px;
    -webkit-overflow-scrolling: touch;
  }

  .quick-actions button,
  .suggestion-row button,
  .chat-suggestions button {
    flex: 0 0 auto;
    white-space: nowrap;
    border: 0;
    border-radius: 999px;
    padding: 9px 13px;
    font-size: 14px;
    background: #e2e8f0;
    color: #0f172a;
  }

  .chat-input-row,
  .chat-form {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    padding-top: 8px;
  }

  .chat-input-row input,
  .chat-form input {
    flex: 1;
    min-width: 0;
    height: 48px;
    border-radius: 999px;
    font-size: 16px;
    padding: 0 16px;
    border: 1px solid #cbd5e1;
  }

  .chat-input-row button,
  .chat-form button {
    height: 48px;
    border-radius: 999px;
    padding: 0 18px;
    font-size: 15px;
    white-space: nowrap;
    background: #0f172a;
    color: white;
  }

  /* Leaflet controls */
  .leaflet-control-zoom {
    margin-top: calc(env(safe-area-inset-top) + 140px) !important;
    margin-left: 16px !important;
  }

  .leaflet-control-attribution {
    display: none !important;
  }

  /* Make popups smaller on mobile */
  .leaflet-popup-content {
    font-size: 13px;
    line-height: 1.35;
  }
}

